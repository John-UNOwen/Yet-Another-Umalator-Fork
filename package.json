{
  "name": "yet-another-umalator-fork",
  "version": "0.0.1",
  "description": "Uma Musume race simulator on the GlobalSim engine (fork of Moomoolator)",
  "homepage": "https://john-unowen.github.io/Yet-Another-Umalator-Fork/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-UNOwen/Yet-Another-Umalator-Fork.git"
  },
  "bugs": {
    "url": "https://github.com/John-UNOwen/Yet-Another-Umalator-Fork/issues"
  },
  "main": "index.js",
  "scripts": {
    "build:global": "cd umalator-global && node build.mjs",
    "build:all": "npm run build:global",
    "dev": "cd umalator-global && node build.mjs --serve 3000",
    "dev:v2": "cd umalator-global/v2 && npx vite",
    "build:v2": "cd umalator-global/v2 && npx vite build",
    "preview:v2": "cd umalator-global/v2 && npx vite preview",
    "dev:team-trials": "cd team-trials && node build.mjs --serve",
    "build:team-trials": "cd team-trials && node build.mjs",
    "preview:team-trials": "cd team-trials && npx vite preview",
    "dev:release-timeline": "cd release-timeline && node build.mjs --serve",
    "build:release-timeline": "cd release-timeline && node build.mjs",
    "preview:release-timeline": "cd release-timeline && npx vite preview",
    "dev:mechanics": "cd umalator-global/mechanics-explorer && node build.mjs --serve 3000",
    "build:mechanics": "cd umalator-global/mechanics-explorer && node build.mjs",
    "test:mechanics": "npx ts-node umalator-global/mechanics-explorer/mechanics.test.ts",
    "test:roster": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/roster/roster.test.ts",
    "test:career-import": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/career-import.test.ts",
    "test:globalsim": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/adapter.test.ts",
    "test:globalsim-skills": "node tools/globalsim-coverage.mjs --out globalsim/skills.merged.json && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/skills.test.ts",
    "test:globalsim-mobs": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/mobs.test.ts",
    "test:globalsim-metrics": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/metrics.test.ts",
    "test:globalsim-pool": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/pool.test.ts",
    "test:globalsim-compact": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/compact-parity.test.ts",
    "test:globalsim-compare": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/compare.acceptance.test.ts",
    "test:globalsim-h2h": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/h2h.acceptance.test.ts",
    "test:globalsim-chart": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/chart.acceptance.test.ts",
    "test:globalsim-skilldata": "node tools/globalsim-coverage.mjs --out globalsim/skills.json && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/skilldata.acceptance.test.ts",
    "test:globalsim-simserver": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/sim-server.acceptance.test.ts",
    "test:optimizer": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/focus.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/space.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/knapsack.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/cache.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/contributions.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/evaluator.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/surrogate.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/book.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/bandit.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/search.oracle.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/search.realistic.test.ts",
    "test:optimizer:slow": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/optimizer/search.exhaustive.test.ts && npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/focus.audit.test.ts",
    "test:skill-drift": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" tools/skill-drift.test.ts",
    "check:skill-drift": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" tools/skill-drift.ts",
    "sim-server": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/engines/globalsim/sim-server.ts",
    "globalsim:coverage": "node tools/globalsim-coverage.mjs",
    "globalsim:coverage:write": "node tools/globalsim-coverage.mjs --write",
    "globalsim:coverage:merged": "node tools/globalsim-coverage.mjs --out globalsim/skills.merged.json",
    "typecheck:roster": "bash tools/typecheck-roster.sh"
  },
  "author": "pecan",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.3",
    "@types/tape": "^5.8.1",
    "commander": "^13.1.0",
    "esbuild": "^0.19.5",
    "tape": "^5.9.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.2",
    "@google/genai": "^2.10.0",
    "@tanstack/react-table": "^8.21.3",
    "d3": "^7.9.0",
    "fast-check": "^4.5.3",
    "immutable": "^5.0.3",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.257.0",
    "prando": "^6.0.1",
    "preact": "^10.18.1",
    "preact-i18n": "^2.4.0-preactx",
    "ts-node": "^10.9.2",
    "unassert-cli": "github:unassert-js/unassert-cli"
  }
}
